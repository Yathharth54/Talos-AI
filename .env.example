# LLM provider (POC uses OpenAI only)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Web search
TAVILY_API_KEY=tvly-...

# Web read (Jina Reader)
JINA_API_KEY=jina_...

# Tracing
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=talos-ai

# Runtime
TALOS_SUBPROCESS_TIMEOUT=10
TALOS_FORGE_MAX_RETRIES=3
