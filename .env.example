# LLM provider — all calls go through OpenRouter (any model slug it serves)
OPENROUTER_API_KEY=sk-or-...
TALOS_MODEL=deepseek/deepseek-v4.1-flash

# Web search
TAVILY_API_KEY=tvly-...

# Web read (Jina Reader)
JINA_API_KEY=jina_...

# Tracing
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=talos-ai

# Runtime
# true = run python_exec/shell_exec without asking first
TALOS_AUTO_APPROVE_EXEC=false
TALOS_SUBPROCESS_TIMEOUT=10
TALOS_FORGE_MAX_RETRIES=3
TALOS_LLM_TIMEOUT=120

# Web app storage (not needed for the CLI)
# DATABASE_URL=postgresql+psycopg://talos:talos@localhost:5432/talos
# memory (CLI default) or postgres (the web app always uses postgres)
TALOS_CHECKPOINTER=memory

# Web app (talos-web). No login: keep the host on 127.0.0.1.
# TALOS_WEB_HOST=127.0.0.1
# TALOS_WEB_PORT=8000
# 1 = the demo's scripted runs: no model calls or keys (for frontend work)
# TALOS_FAKE_GRAPH=0
# 1 = allow CORS from Vite's dev server (http://127.0.0.1:5173)
# TALOS_WEB_DEV=0
