# Environments
.venv/
venv/
env/
.env
.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
build/
dist/

# Testing / tooling
.pytest_cache/
.ruff_cache/
.coverage
